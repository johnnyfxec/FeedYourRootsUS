# Python
__pycache__/
*.pyc

# Temporales de trabajo (nunca deben commitearse -- ver protocolo)
_tests_output/
_test_*.png
_check_*.png
_grid_*.png

# Produccion para redes sociales (solo vive en Termux -- el repo es
# gobernanza + compositores/motor + web, nunca output de contenido)
production/assets_local/
production/output/
production/pieces/*/_trabajo/
pdfs_normalized/
tts.log
render.log

# Secretos locales (20-oct-2026): credenciales OAuth/API que drive_client.py y otros
# clientes leen de variables de entorno -- viven SOLO en un .env fuera del repo en Termux,
# nunca aqui. Esta regla es un cinturon de seguridad extra (defense in depth): si alguna
# vez por error se crea un .env dentro del repo, esto evita que git lo suba.
.env
.env.*
!.env.example
